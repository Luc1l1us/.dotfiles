@theme "/usr/share/rofi/themes/arthur.rasi"

* {
  font: "Jetbrains Mono 12";
}

window {
  height: 20%;
  width: 70%;
  border: 2px;
  border-color: rgba(0,0,0,0.3);
  }

mainbox {
    children: [window-colorbar, listview];
  }

window-colorbar {
  location: center;
  anchor: center;
  // transparency: "background";
  transparency: "path:/home/Dizzy/.dotfiles/BlacknWhite/Wallpaper/bw_2.png";
}

listview {
    spacing: 90px;
    layout: horizontal;
    border: 1px;                        
    border-color: rgba(95,68,131,0.3);      
    border-radius: 10px;
    children: [element];
  }

element {
    padding: 20px;
    children: [button-paste];
  }

element selected.normal {
    background-color: transparent;
    border: 3px;
    border-color: rgba(95,68,131,0.3);
  }
