configuration {
  modi: "drun";
  show-icons: true;
  drun-display-format: "{name} \r[<span weight='light' size='small'>{comment}</span>]";
  modes: "drun";
  display-drun: " ";
}

@theme "/usr/share/rofi/themes/arthur.rasi"

* {
  font: "Jetbrains Mono 12";
}

element {
  orientation: horizontal;
  children: [ element-icon, element-text ];
  spacing: 5px;
}

element-index {
  text-color: rgba(95,68,131,1);
  }

listview {
    lines: 3;
    enabled: true;
    background-color: rgba(0,0,0,0.5);
    border: 0;
    cycle: true;
  }

element-text {
  font: "noto-fonts";
  text-color: white;
  children: [textbox];
}

element selected.normal {
    border: 0px;
    background-color: rgba(95,68,131,0.5);
}

inputbar {
  location: center;
  anchor: center;
  background-color: rgba(0,0,0,0.5);
  border: 0px;
  padding: 30px 20px 20px 20px;
  text-color: white;
}

mainbox {
    border: 2px;
    border-color: rgba(95,68,131,0.3);
    border-radius: 10px;
    padding: 0px;
  }

prompt { //erase prompt
// enabled: false;
  enabled: true;
  text-color: rgba(95,68,131,1);
  font: "Jetbrains Mono 20";
  }

window {
    height: 28%;
    width: 35%;
    padding: 20px;
    border: 1px;
    border-radius: 10px;
    border-color: rgba(0,0,0,0.3);
  }
  
element-icon {
 size: 2em;
 background: transparent;
}

