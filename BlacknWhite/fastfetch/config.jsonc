{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch_logo.txt",
    "color": {
      "1": "white",
      "2": "black"
    },
    "padding": {
      "top": 2,
      "right": 5,
      "left": 4
    }
  },
  "display": {
    "separator": ""
  },
  "modules": [
    //"title",
    //"separator",
    // SOFTWARE
    "break",
    {
      "type": "custom",
      "format": "╭───────────╮"
    },
    {
      "type": "title",
      "key": "\u001b[0m│\u001b[38;2;250;208;196m \uf007 user    \u001b[0m│",
      "format": " {user-name}"
    },
    {
      "type": "os",
      "key": "\u001b[37m│ \u001b[38;2;162;194;232m\udb82\udcc7 distro  \u001b[37m│",
      "format": " {name}"
    },
    {
      "type": "kernel",
      "key": "\u001b[37m│ \u001b[38;2;163;217;165m kernel  \u001b[37m│ "
    },
    {
      "type": "shell",
      "key": "\u001b[37m│ \u001b[38;2;209;163;224m shell   \u001b[37m│ "
    },
    {
      "type": "wm",
      "key": "\u001b[37m│ \u001b[38;2;243;226;127m  WM     \u001b[37m│ "
    },
    // HARDWARE
    {
      "type": "cpu",
      "key": "\u001b[37m│ \u001b[38;2;245;176;149m  CPU    \u001b[37m│ "
    },
    {
      "type": "gpu",
      "key": "\u001b[37m│ \u001b[38;2;255;218;185m󱁉  GPU    \u001b[37m│ "
    },
    {
      "type": "memory",
      "key": "\u001b[37m│\u001b[38;2;227;212;243m   RAM    \u001b[37m│ "
    },
    {
      "type": "display",
      "key": "\u001b[37m│ \u001b[38;2;184;228;214m󰍹  display\u001b[37m│ "
    },
    // UPTIME
    {
      "type": "uptime",
      "key": "\u001b[37m│ \u001b[38;2;255;185;161m\uf017  uptime \u001b[37m│ "
    },
    {
      "type": "custom",
      "format": "╰───────────╯"
    },
  ]
}
